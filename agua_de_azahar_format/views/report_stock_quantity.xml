<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Plantilla que hereda y modifica el documento de entrega original -->
    <template id="report_delivery_document_quantity" inherit_id="stock.report_delivery_document">
        <!-- Eliminar el encabezado de la columna "Entregado" en la tabla de pedidos no completados -->
        <xpath expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_quantity']" position="replace">
        </xpath>

        <!-- Eliminar las celdas de datos correspondientes -->
        <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[3]" position="replace">
        </xpath>

        <!-- Eliminar el encabezado de la columna "Entregado" en la tabla de pedidos completados -->
        <xpath expr="//table[@name='stock_move_line_table']/thead/tr/th[@name='th_sml_quantity']" position="replace">
        </xpath>

        <!-- Agregar encabezados de nuevas columnas después de la última columna existente -->
        <xpath expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_ordered']" position="after">
            <th class="text-end">Unidades/Caja</th>
            <th class="text-end">Total Unidades</th>
        </xpath>

        <!-- Añadir las nuevas columnas después de la columna de cantidad ordenada -->
        <xpath expr="//span[@t-field='move.product_uom_qty']/ancestor::td[1]" position="after">
            <!-- Unidades por caja -->
            <td class="text-end">
                <t t-if="move.product_id.uom_id and move.product_uom and move.product_uom.category_id == move.product_id.uom_id.category_id">
                    <span t-esc="int(move.product_uom.factor_inv or 1)"/>
                </t>
                <t t-else="">
                    <span>1</span>
                </t>
            </td>
            <!-- Total unidades -->
            <td class="text-end">
                <t t-if="move.product_id.uom_id and move.product_uom and move.product_uom.category_id == move.product_id.uom_id.category_id">
                    <span t-esc="int(move.product_uom_qty * (move.product_uom.factor_inv or 1))"/>
                </t>
                <t t-else="">
                    <span t-field="move.product_uom_qty"/>
                </t>
            </td>
        </xpath>
    </template>


    <!-- Template para mostrar el reporte completo -->
    <template id="report_delivery_quantity">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="agua_de_azahar_format.report_delivery_document_quantity" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
