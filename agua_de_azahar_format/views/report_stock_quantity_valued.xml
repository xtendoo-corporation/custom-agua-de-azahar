<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data inherit_id="stock_picking_report_valued.valued_report_picking" priority="17">
        <xpath expr="//div[hasclass('page')]" position="before">
            <t t-set="is_outgoing" t-value="o.picking_type_code == 'outgoing'"/>
        </xpath>

        <xpath expr="//table[@name='stock_move_line_table']/thead/tr" position="inside">
            <t t-if="o.valued and o.sale_id and o.move_line_ids and is_outgoing">
                <th class="text-end"><strong>Unit Price</strong></th>
                <th class="text-end" groups="product.group_discount_per_so_line">
                    <strong>Discount</strong>
                </th>
                <th class="text-end"><strong>Subtotal</strong></th>
                <th class="text-end"><strong>Taxes</strong></th>
                <th class="text-end"><strong>Unidades Individuales</strong></th>
                <th class="text-end"><strong>Precio por Unidad Individual</strong></th>
            </t>
        </xpath>

        <xpath expr="//table[@name='stock_move_line_table']/tbody/tr" position="inside">
            <td class="text-end">
                <t t-if="move.product_uom and move.product_uom.factor_inv">
                    <span t-esc="move.product_uom.factor_inv * move.product_uom_qty" t-options="{'widget': 'float', 'precision': 2}"/>
                </t>
                <t t-else="">
                    <span t-field="move.product_uom_qty"/>
                </t>
            </td>
            <td class="text-end">
                <t t-if="move.product_uom and move.product_uom.factor_inv > 0">
                    <span t-esc="move.price_unit / move.product_uom.factor_inv" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                </t>
                <t t-else="">
                    <span t-field="move.price_unit"/>
                </t>
            </td>
        </xpath>
    </data>

    <record id="action_report_delivery_quantity_valued" model="ir.actions.report">
        <field name="name">Albarán valorado con detalle de unidades</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">agua_de_azahar_format.report_delivery_quantity_valued</field>
        <field name="report_file">agua_de_azahar_format.report_delivery_quantity_valued</field>
        <field name="print_report_name">'Albarán valorado - %s' % object.name</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_delivery_quantity_valued">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="agua_de_azahar_format.report_delivery_document_quantity_valued" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
